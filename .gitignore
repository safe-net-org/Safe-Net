# Environment files and secrets. Templates remain versioned.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx

# Build output, test reports, and temporary runtime files
.next/
dist/
build/
coverage/
.nyc_output/
playwright-report/
test-results/
*.tsbuildinfo
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python local state
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local-only archives and database dumps can contain real user data.
_archive/
*.sqlite
*.sqlite3
*.db

# Extension build artifacts (WXT)
.output/
.wxt/
