# Base URL of the Safe-Net API. Must include the /api prefix.
# Previously hardcoded in constants/constants.ts, which made deploys impossible
# without a code change.
NEXT_PUBLIC_API_URL=http://localhost:4200/api

# SafeNet Guard ML service (optional). The /guard scanner asks it for a second
# opinion; if it is offline the scanner still works on local rules alone.
NEXT_PUBLIC_ML_URL=http://localhost:8000

# Required before a public production launch. When any value is missing,
# localized legal pages explicitly identify the deployment as a product preview.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION=
