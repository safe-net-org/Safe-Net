{
	"name": "safe-net-server",
	"version": "1.0.0",
	"description": "Safe-Net LMS API — NestJS + Prisma + PostgreSQL",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"dev": "nest start --watch",
		"debug": "nest start --debug --watch",
		"prod": "node dist/main",
		"check-db": "node check-db-connection.js",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"validate:content": "tsx src/content/validate-content.ts",
		"test": "jest",
		"test:watch": "jest --watch",
		"sync-achievements": "tsx prisma/sync-achievements.ts",
		"backfill-bonus-xp": "tsx prisma/backfill-bonus-xp.ts"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@nestjs/common": "^10.3.2",
		"@nestjs/config": "^3.2.0",
		"@nestjs/core": "^10.0.0",
		"@nestjs/jwt": "^10.2.0",
		"@nestjs/mapped-types": "*",
		"@nestjs/passport": "^10.0.3",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-pg": "^7.2.0",
		"@prisma/client": "^7.2.0",
		"@types/pg": "^8.16.0",
		"argon2": "^0.31.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.6",
		"date-fns": "^3.3.1",
		"dotenv": "^16.4.5",
		"gray-matter": "^4.0.3",
		"helmet": "^8.3.0",
		"nestjs": "^0.0.1",
		"nodemailer": "^6.9.11",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.16.3",
		"reflect-metadata": "^0.1.13",
		"resend": "^6.18.1",
		"rxjs": "^7.8.1",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@trivago/prettier-plugin-sort-imports": "^6.0.0",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.2",
		"@types/node": "^20.3.1",
		"@types/nodemailer": "^6.4.14",
		"@types/supertest": "^6.0.0",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"jest": "^29.5.0",
		"prettier": "^3.7.4",
		"prisma": "^7.2.0",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.3",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.1.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/$1"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
