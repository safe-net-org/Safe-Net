DATABASE_URL=postgresql://postgres:postgres@localhost:5433/safenet?schema=public

# Both JWT secrets are required and must be different.
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:3000

# Transactional email delivery for password reset and email verification.
# Replace the placeholder with a real API key from Resend. Never commit it.
RESEND_API_KEY=re_xxxxxxxxx
# Must use a sender address from a verified Resend domain in production.
RESEND_FROM=Safe Net <no-reply@example.com>

# Optional SMTP fallback for another relay. It is used only when RESEND_API_KEY
# is not configured.
# SMTP_HOST and SMTP_FROM are required when NODE_ENV=production.
# SMTP_USER and SMTP_PASSWORD must be set together.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Safe Net <no-reply@example.com>

# Development-only escape hatch for testing password reset without SMTP.
# Never enable in production: the log contains the recipient and raw reset URL.
PASSWORD_RESET_DEBUG_LOG=false

# API port. Defaults to 4200 when unset.
PORT=4200

# Set to "production" in production: it switches auth cookies to secure +
# SameSite=None. FRONTEND_URL must then be the exact public web origin.
NODE_ENV=development
