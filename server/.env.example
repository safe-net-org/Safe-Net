DATABASE_URL=postgresql://postgres:postgres@localhost:5433/safenet?schema=public
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:3000

# API port. Defaults to 4200 when unset.
PORT=4200

# Set to "production" in production: it switches the refresh-token cookie to
# secure + SameSite=None. Leave unset locally so the cookie works over HTTP.
NODE_ENV=development
